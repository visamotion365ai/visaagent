# VisaMOTion AI Agency - Environment Variables
# Copy this file to .env and fill in your actual values

# App Configuration
VITE_APP_NAME=VisaMOTion AI Agency
VITE_APP_VERSION=1.0.0
VITE_COMPANY_NAME=VisaMOTion Pte. Ltd.

# Supabase Configuration (Required for production)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI API Keys (Required for AI features)
# Get your Mistral API key from: https://console.mistral.ai/
VITE_MISTRAL_API_KEY=your-mistral-api-key

# Get your Google Gemini API key from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your-gemini-api-key

# Optional: AI Configuration Overrides
VITE_AI_DEFAULT_PROVIDER=mistral
VITE_AI_DEFAULT_MODEL=mistral-tiny-latest
VITE_AI_TEMPERATURE=0.7
VITE_AI_MAX_TOKENS=4096

# File Upload Configuration
VITE_MAX_FILE_SIZE_MB=10
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# App Settings
VITE_DEFAULT_LANGUAGE=bn
VITE_SUPPORTED_LANGUAGES=bn,en,ar,hi,ur
VITE_DEFAULT_CURRENCY=BDT
VITE_TIMEZONE=Asia/Dhaka

# PWA Configuration
VITE_PWA_NAME=VisaMOTion AI Agency
VITE_PWA_SHORT_NAME=VisaMOTion
VITE_PWA_DESCRIPTION=Bangladesh-based visa consultancy and international recruitment agency platform
VITE_PWA_THEME_COLOR=#1e40af
VITE_PWA_BACKGROUND_COLOR=#f8fafc

# Security
VITE_ENABLE_AUDIT_LOG=true
VITE_ENABLE_ANALYTICS=false

# API Configuration
VITE_API_TIMEOUT=30000
VITE_API_MAX_RETRIES=3
